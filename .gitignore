# Created by https://www.toptal.com/developers/gitignore/api/dotnet
# Edit at https://www.toptal.com/developers/gitignore?templates=dotnet

### VisualStudio ###
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Files
*.vscode

# Visual Studio generated files
*.csproj.user

# Visual Studio 6 workspace options file
*.opt

# Visual Studio 6 auto-generated workspace file (contains which files were open etc.)
*.vbw

# Visual Studio LightSwitch generated files
GeneratedArtifacts/
_Pvt_Extensions/
ModelManifest.xml

# Visual Studio User Specific Files
*.app.config.user
*.package.config.user

# Visual Studio 2017/2019
*.prefs

# MSBuild
*.msbuildproject
*.msbuilduser

# Package restore
*.nupkg
*.snupkg
!**/packages/*/build/**

# Build results of a .NET project
# These have been moved to the /bin and /obj returns in newer templates

# Windows Azure Build Output
csx/
*.build.csdef
*.build.cspkg

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.appxupload

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.sln
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Including strong name files can present a security risk
# (https://github.com/github/gitignore#structural-optimization)
# When misused in conjunction with strong naming, this can be a security issue.
*.snk

# Since there are multiple workflows, uncomment next line to ignore bower_components
# (https://github.com/github/gitignore#structural-optimization)
#bower_components/

# RIA/Silverlight projects
Generated_Code/

# Backup & report files from converting an old project file
# to a newer Visual Studio version. Backup files are not needed,
# because we have git ;-)
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft F# tools
*.fsx
*.fsi
FSharpInteractiveRunner.exe

# Node.js Files
.nodeinspect

# JavaScript build output
dist/
webdist/
build/
Generated/
bundles/
node_modules/

# Azure Functions
.local
local.settings.json

# JetBrains Rider
.idea/
*.sln.iml
.DotSettings.user

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

### VisualStudio Patch ###
# Additional files generated by Visual Studio

# Directory to store the MSBuild output
artifacts/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# xUnit
xunit.runner.json
*.trx
*.coverage
*.coveragexml
*.dacpac

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/
*.jittedmethods
*.tiered
*.etl
*.etlx
*.rsdc

# SpecFlow/BDD
SpecFlow.*.json
SpecFlow.Obsolete.xml
specflow.html
specflow.xlsx

# RestSharp
RestSharp.CodeAnalysis.xml

# React
public/bundle*
netcore-spa.js

# WebStorm
.idea/

# GitLFS
*.lfs

# VSTS
.app/

# TestTorrent
*.TestTorrent

# Compiled source files
*.com
*.class
*.dll
*.exe
*.pdb
*.dll.mdb
*.exe.mdb
*.pdbopt
*.pdbgid

# Custom build
custombuild/

# Disk Images
# Do not commit the actual images! Comment this out if you actually need them
*.iso
*.img
*.vhd
*.vhdx

# Binaries
*.bin
*.dmp
*.so

